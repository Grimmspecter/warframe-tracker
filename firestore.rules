rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every signed-in player can read every profile and its progress.
    // Each player can only change their own.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /data/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
